# Copy to .env and fill in what you use.

# Knowledge base (build your own with scripts/ingest.py)
CORPUS_PATH=data/sample_corpus.jsonl

# Retrieval: embedding | tfidf
RETRIEVER=embedding
EMBEDDING_MODEL=intfloat/multilingual-e5-base
TOP_K=4

# Generation: anthropic | openai | extractive | retrieval
GENERATOR=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EXTRACTIVE_MODEL=savasy/bert-base-turkish-squad
